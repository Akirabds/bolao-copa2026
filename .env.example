# ===========================================
# BOLÃO DA COPA 2026 — Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env.local e preencha os valores

# Banco de dados (SQLite local ou PostgreSQL em produção)
DATABASE_URL="file:./dev.db"
# Para PostgreSQL: DATABASE_URL="postgresql://user:password@host:5432/bolao_copa2026"

# Segredo JWT (gere com: openssl rand -base64 32)
JWT_SECRET="seu-segredo-jwt-aqui-minimo-32-caracteres-aleatorios"

# URL base da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Mercado Pago (produção)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# E-mail (SMTP) - para notificações futuras
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@bolaocopа2026.com.br"

# Admin padrão (usado apenas no seed inicial)
ADMIN_EMAIL="admin@seudominio.com"
ADMIN_PASSWORD="troque-esta-senha"

# Configurações da plataforma
NEXT_PUBLIC_PLATFORM_NAME="Bolão da Copa 2026"
NEXT_PUBLIC_PHASE1_PRICE="19.90"
NEXT_PUBLIC_PHASE2_PRICE="10.00"
