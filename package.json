{
  "name": "bolao-copa2026",
  "version": "1.0.0",
  "description": "Bolão da Copa do Mundo 2026 - Sistema completo de palpites e ranking",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,sync -c cyan,green \"next dev -H 0.0.0.0\" \"node scripts/sync-poller.mjs\"",
    "dev:next": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:next": "next build",
    "start": "concurrently -n next,sync -c cyan,green \"next start -H 0.0.0.0\" \"node scripts/sync-poller.mjs\"",
    "start:next": "next start -H 0.0.0.0",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "cross-env DATABASE_URL=file:./dev.db tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && cross-env DATABASE_URL=file:./dev.db tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@prisma/client": "5.16.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.1.3",
    "jose": "5.6.3",
    "lucide-react": "0.414.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.52.2",
    "recharts": "2.12.7",
    "sonner": "1.5.0",
    "tailwind-merge": "2.4.0",
    "web-push": "^3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.13",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.40",
    "prisma": "5.16.0",
    "tailwindcss": "3.4.7",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
  }
}
